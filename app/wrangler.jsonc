{
  // Cloudflare Worker serving Vantage as static assets, and /llms.txt from the vantage function.
  // `pnpm run deploy` builds dist/ and uploads it with wrangler, passing SUPABASE_URL.
  "name": "vantage",
  "compatibility_date": "2026-10-01",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/llms.txt"],
  },
}
