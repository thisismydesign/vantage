{
  "name": "vantage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vantage — hosted watchlist, charts, portfolio and trades on Supabase and Cloudflare.",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite app",
    "build": "vite build app",
    "preview": "vite preview app",
    "deploy": "pnpm run build && cd app && wrangler deploy",
    "supabase:deploy": "supabase db push && supabase functions deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@mantine/charts": "^9.5.0",
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tabler/icons-react": "^3.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.2.0",
    "wrangler": "^4.151.0"
  }
}
