# Copy to `.env` and fill in with the hosted project. `.env` is gitignored.
# Production only: builds, deploys and `E2E_BASE_URL` runs. Development reads
# `.env.development` (the local stack) over it.
# Project dashboard: https://supabase.com/dashboard/project/<ref>
# `supabase projects api-keys --project-ref <ref>` lists the keys.
SUPABASE_URL=          # https://<ref>.supabase.co — server-side scripts and e2e
SUPABASE_SECRET_KEY=   # service_role key — server-side only, never shipped to a browser
VITE_SUPABASE_URL=     # same URL; read by the app at build time
VITE_SUPABASE_KEY=     # anon key — safe to embed in the browser bundle
VANTAGE_TEST_EMAIL=    # the end-to-end test user; created on first run, never emailed
