{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "tests/**/*.ts", "supabase/functions/_shared/**/*.ts"],
  "exclude": ["supabase/functions/_shared/flex.ts"]
}
