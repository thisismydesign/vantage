{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "lint/**/*.ts", "tests/**/*.ts", "e2e/**/*.ts", "playwright.config.ts", "supabase/functions/_shared/**/*.ts"]
}
